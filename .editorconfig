root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
# YAML block text can contain meaningful trailing whitespace.
trim_trailing_whitespace = false

[*.xml]
indent_style = space
indent_size = 4

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

# Markdown may deliberately use two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false
